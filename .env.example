# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Generate each password_hash with: python scripts/hash_password.py
AUTH_USERS_JSON=[{"username":"admin","password_hash":"$argon2id$REPLACE_ME","role":"admin"}]

# Generate both values with: python scripts/generate_security_keys.py
EVIDENCE_ENCRYPTION_KEY=replace-with-generated-base64-key
AUDIT_HMAC_KEY=replace-with-a-different-generated-base64-key

# API perimeter. Keep origins empty for non-browser clients.
ALLOWED_ORIGINS_JSON=[]
ALLOWED_HOSTS_JSON=["api.example.org","localhost","127.0.0.1"]
MAX_REQUEST_BODY_BYTES=65536
API_RATE_LIMIT=120
API_RATE_WINDOW_SECONDS=60
