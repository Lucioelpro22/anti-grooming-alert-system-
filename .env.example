# Generate with: openssl rand -hex 32
JWT_SECRET=INSECURE_EXAMPLE_DO_NOT_USE_IN_PRODUCTION_GENERATE_NEW_SECRET_WITH_OPENSSL
# Optional JWT rotation ring. Historical tokens without kid require the old
# signing secret under the reserved "legacy" ID until their maximum TTL expires.
JWT_SECRETS_JSON=
JWT_CURRENT_KEY_ID=

# Generate each password_hash with: python scripts/hash_password.py
AUTH_USERS_JSON=[{"username":"admin","password_hash":"$argon2id$v=19$m=65540,t=3,p=4$REPLACE_WITH_ACTUAL_HASH$REPLACE_WITH_ACTUAL_HASH","role":"admin"}]

# MFA is required by default for admin, supervisor and auditor roles.
# Generate enrollment material with:
# python scripts/generate_mfa.py --username admin
MFA_REQUIRED_ROLES_JSON=["admin","supervisor","auditor"]
MFA_USERS_JSON={}
MFA_STATE_BACKEND=memory

# Generate all three values with: python scripts/generate_security_keys.py
EVIDENCE_ENCRYPTION_KEY=INSECURE_EXAMPLE_REPLACE_WITH_GENERATED_BASE64_KEY_32_BYTES
# Optional rotation ring. If set, use JSON like {"v1":"base64-key","v2":"base64-key"}.
EVIDENCE_ENCRYPTION_KEYS_JSON=
EVIDENCE_ENCRYPTION_CURRENT_KEY_ID=
AUDIT_HMAC_KEY=INSECURE_EXAMPLE_REPLACE_WITH_DIFFERENT_GENERATED_BASE64_KEY
# Optional rotation ring. When enabled, historical pre-key-id entries require
# the original key under the literal "legacy" ID.
AUDIT_HMAC_KEYS_JSON=
AUDIT_HMAC_CURRENT_KEY_ID=
PSEUDONYMIZATION_HMAC_KEY=INSECURE_EXAMPLE_REPLACE_WITH_A_SEPARATE_HMAC_KEY

# Absolute path OUTSIDE informes_generados, with independent permissions/backups.
# All workers must share this local SQLite database (not a network filesystem).
AUDIT_STATE_DB=/var/lib/anti-grooming-audit/checkpoint.sqlite

# API perimeter. Keep origins empty for non-browser clients.
ALLOWED_ORIGINS_JSON=[]
ALLOWED_HOSTS_JSON=["api.example.org","localhost","127.0.0.1"]
MAX_REQUEST_BODY_BYTES=65536
API_RATE_LIMIT=120
API_RATE_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=memory
TOKEN_REVOCATION_BACKEND=memory
SESSION_BACKEND=memory
REFRESH_TOKEN_DAYS=7
REDIS_URL=
DATABASE_URL=
